rules_version = '2';

// Package generator quotes (public/package/package-core.js). Managers sign in
// with an SMS code (Firebase phone auth) or their number and a password
// (public/package/auth.js):
//   - anyone holding a code can read that one quote (the guest's link);
//   - only signed-in managers can list quotes, so codes can't be harvested;
//   - only signed-in managers can create quotes, recording their own number
//     as `by`;
//   - managers can change a quote's status, or edit its contents (the guest's
//     link then shows the new version), recording who did; nobody can delete
//     one;
//   - created quotes must have the expected shape and size.
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per manager, its ID the sign-in number ("+919876543210").
    // Kept here rather than in the repo so the numbers never reach git. Added
    // and removed in the Firebase console, which these rules don't restrict.
    //   - anyone can fetch one by its exact number (the generator checks before
    //     sending an SMS), but nobody can list them or write them from the web.
    match /managers/{phone} {
      allow get: if true;
      allow list, write: if false;
    }

    // The manager's sign-in number ("+919876543210"). A password account is the
    // address auth.js makes from it: 919876543210@managers.chamtaburu.in.
    function isPasswordAccount() {
      return request.auth.token.get('email', '').matches('^91[0-9]{10}@managers[.]chamtaburu[.]in$');
    }
    function managerId() {
      return isPasswordAccount()
        ? '+' + request.auth.token.email.split('@')[0]
        : request.auth.token.get('phone_number', '');
    }
    // A phone account is a manager if their number has a document. A password
    // account also needs that document's `uid` to be its own, so creating the
    // address yourself doesn't make you a manager.
    function isManager() {
      return request.auth != null
        && managerId() != ''
        && exists(/databases/$(database)/documents/managers/$(managerId()))
        && (!isPasswordAccount()
          || get(/databases/$(database)/documents/managers/$(managerId())).data.get('uid', '') == request.auth.uid);
    }

    // An admin is a manager whose document has role "admin" (set in the Firebase
    // console): they also approve travel partners and set the B2B discounts.
    function isAdmin() {
      return isManager()
        && get(/databases/$(database)/documents/managers/$(managerId())).data.get('role', '') == 'admin';
    }

    // The manager may save property `p`: their document lists it in `props`,
    // or lists none.
    function managesProperty(p) {
      let props = get(/databases/$(database)/documents/managers/$(managerId())).data.get('props', null);
      return props == null || p in props;
    }

    // A travel partner's account (public/partners): email and password, the
    // email verified. Never a manager's password account, whose made-up address
    // can't be verified anyway.
    function verifiedPartnerEmail() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && !request.auth.token.get('email', '').matches('.*@managers[.]chamtaburu[.]in$');
    }
    function approvedPartner(p) {
      return verifiedPartnerEmail()
        && exists(/databases/$(database)/documents/partners/$(request.auth.uid))
        && get(/databases/$(database)/documents/partners/$(request.auth.uid)).data.status == 'approved'
        && p in get(/databases/$(database)/documents/partners/$(request.auth.uid)).data.get('props', ['village', 'resort']);
    }

    // Travel partners, one document per partner account, its ID the account's
    // UID (public/package/b2b-core.js). The partner signs up with their business
    // details as "pending" and can correct them while pending; an admin approves
    // or suspends them and sets which properties' B2B rates they see. Managers
    // read the list; a partner reads only their own; nobody deletes one.
    match /partners/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isManager();
      allow list: if isManager();
      allow delete: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && verifiedPartnerEmail()
        && request.resource.data.keys().hasOnly(['agency', 'contact', 'phone', 'city', 'gstin', 'web', 'member', 'email', 'terms', 'status', 'created'])
        && partnerProfileOk(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.terms is string && request.resource.data.terms.size() <= 20
        && request.resource.data.status == 'pending'
        && request.resource.data.created == request.time;
      allow update: if (isAdmin() && partnerStatusChange())
        || (request.auth != null && request.auth.uid == uid && verifiedPartnerEmail()
          && (partnerSeen() || (resource.data.status == 'pending' && partnerProfileEdit())));

      function partnerProfileOk(d) {
        return d.agency is string && d.agency.size() >= 2 && d.agency.size() <= 100
          && d.contact is string && d.contact.size() >= 2 && d.contact.size() <= 80
          && d.phone is string && d.phone.matches('^91[6-9][0-9]{9}$')
          && d.city is string && d.city.size() >= 2 && d.city.size() <= 60
          && (!('gstin' in d) || (d.gstin is string && d.gstin.matches('^[0-9]{2}[A-Z0-9]{13}$')))
          && (!('web' in d) || (d.web is string && d.web.size() <= 200))
          && (!('member' in d) || (d.member is string && d.member.size() <= 60));
      }
      function partnerProfileEdit() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agency', 'contact', 'phone', 'city', 'gstin', 'web', 'member'])
          && partnerProfileOk(request.resource.data);
      }
      function partnerSeen() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
          && request.resource.data.lastSeenAt == request.time;
      }
      function partnerStatusChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'props', 'statusBy', 'statusAt'])
          && request.resource.data.status in ['pending', 'approved', 'suspended']
          && request.resource.data.props is list
          && request.resource.data.props.size() >= 1
          && request.resource.data.props.hasOnly(['village', 'resort'])
          && request.resource.data.statusBy == managerId()
          && request.resource.data.statusAt == request.time;
      }
    }

    // B2B (net) rates, one document per property (public/package/b2b-core.js):
    // discounts off the public rate calendar. Only managers and approved
    // partners for that property can read it; the website never does. An
    // admin creates it and sets the discounts (`plan`); managers mark peak,
    // custom and closed dates (`days`) for the properties they manage.
    match /b2bRates/{property} {
      allow get: if property in ['village', 'resort'] && (isManager() || approvedPartner(property));
      allow list, delete: if false;
      allow create: if isAdmin() && property in ['village', 'resort'] && b2bShape();
      allow update: if isManager()
        && property in ['village', 'resort']
        && (isAdmin() || (managesProperty(property)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan'])))
        && b2bShape();

      function b2bShape() {
        return request.resource.data.keys().hasOnly(['plan', 'days', 'updatedBy', 'updatedAt'])
          && request.resource.data.plan is string
          && request.resource.data.plan.size() < 5000
          && request.resource.data.days is map
          && request.resource.data.days.size() <= 1000
          && request.resource.data.updatedBy == managerId()
          && request.resource.data.updatedAt == request.time;
      }
    }

    match /quotes/{code} {
      allow get: if true;
      allow list: if isManager();
      allow delete: if false;
      // `by` and `status` are optional only so a generator page opened before
      // they existed can still save while this deploys; when present they
      // must be the manager's own number and "sent".
      allow create: if isManager()
        && code.matches('^[2-9A-HJKMNP-Z]{6}$')
        && request.resource.data.keys().hasOnly(['q', 'p', 'created', 'by', 'status'])
        && (!('by' in request.resource.data) || request.resource.data.by == managerId())
        && (!('status' in request.resource.data) || request.resource.data.status == 'sent')
        && request.resource.data.q is string
        && request.resource.data.q.size() < 20000
        && request.resource.data.p in ['village', 'resort']
        && request.resource.data.created == request.time;
      allow update: if isManager() && (statusChange() || contentEdit());

      function statusChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusBy', 'statusAt'])
          && request.resource.data.status in ['sent', 'confirmed', 'cancelled']
          && request.resource.data.statusBy == managerId()
          && request.resource.data.statusAt == request.time;
      }
      function contentEdit() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['q', 'editedBy', 'editedAt'])
          && request.resource.data.q is string
          && request.resource.data.q.size() < 20000
          && request.resource.data.editedBy == managerId()
          && request.resource.data.editedAt == request.time;
      }
    }

    // The generator form behind each quote, for Edit. Managers only: it holds
    // the guest's phone number. Written in the same commit as its quote.
    match /quoteForms/{code} {
      allow get: if isManager();
      allow list, delete: if false;
      allow create, update: if isManager()
        && existsAfter(/databases/$(database)/documents/quotes/$(code))
        && request.resource.data.keys().hasOnly(['f'])
        && request.resource.data.f is string
        && request.resource.data.f.size() < 20000;
    }

    // The rate calendar (public/package/calendar.js), one document per
    // property. Anyone can read it: the website's room pages show these rates.
    // Managers save it, but only for the properties their manager document
    // lists in `props` (every property when it lists none), recording who
    // saved last. `base` is the normal rates and `days` each date's changes,
    // both JSON (see "Rate calendar" in public/package/package-core.js).
    match /rates/{property} {
      allow get: if property in ['village', 'resort'];
      allow list, delete: if false;
      allow create, update: if isManager()
        && property in ['village', 'resort']
        && managesProperty(property)
        && request.resource.data.keys().hasOnly(['base', 'days', 'updatedBy', 'updatedAt'])
        && request.resource.data.base is string
        && request.resource.data.base.size() < 20000
        && request.resource.data.days is map
        && request.resource.data.days.size() <= 1000
        && request.resource.data.updatedBy == managerId()
        && request.resource.data.updatedAt == request.time;
    }

    // Booking requests from the website's /book page and its Contact page
    // enquiry form (`src` "contact"), src/lib/bookingRequest.ts. A Google Apps
    // Script run by the project's owner reads new ones to email the office
    // (scripts/request-alerts): it uses the owner's own access, not these rules.
    // Anyone can send one, in exactly this shape, as status "new"; it holds the
    // guest's name and number, so only managers can read them. Managers move
    // it on (a package sent, booked, declined), recording who; nobody deletes.
    match /bookingRequests/{code} {
      allow get, list: if isManager();
      allow delete: if false;
      allow create: if code.matches('^[2-9A-HJKMNP-Z]{6}$')
        && request.resource.data.keys().hasOnly(['p', 'room', 'roomName', 'ac', 'ci', 'co', 'a', 'k', 'name', 'phone', 'note', 'est', 'extras', 'items', 'src', 'status', 'created'])
        && request.resource.data.keys().hasAll(['p', 'room', 'roomName', 'ac', 'ci', 'co', 'a', 'k', 'name', 'phone', 'status', 'created'])
        && request.resource.data.p in ['village', 'resort']
        && request.resource.data.room is string && request.resource.data.room.matches('^[a-z0-9-]{1,40}$')
        && request.resource.data.roomName is string && request.resource.data.roomName.size() <= 80
        && request.resource.data.ac is bool
        && request.resource.data.ci is string && request.resource.data.ci.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.co is string && request.resource.data.co.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.co > request.resource.data.ci
        && request.resource.data.a is int && request.resource.data.a >= 1 && request.resource.data.a <= 30
        && request.resource.data.k is int && request.resource.data.k >= 0 && request.resource.data.k <= 30
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('^91[6-9][0-9]{9}$')
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && (!('est' in request.resource.data) || (request.resource.data.est is int && request.resource.data.est >= 0))
        && (!('src' in request.resource.data) || request.resource.data.src == 'contact')
        // Extras the guest asked for: ids from src/content/extras.ts.
        && (!('extras' in request.resource.data) || (request.resource.data.extras is list
          && request.resource.data.extras.size() <= 12
          && request.resource.data.extras.hasOnly(['pickup-purulia', 'pickup-barabhum', 'drop-purulia', 'drop-barabhum', 'day1', 'day2', 'day3', 'meals', 'bonfire', 'decor'])))
        // Every room type asked for, as { room, name, q, ac } (managers read it defensively).
        && (!('items' in request.resource.data) || (request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 8))
        && request.resource.data.status == 'new'
        && request.resource.data.created == request.time;
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusBy', 'statusAt', 'quote'])
        && request.resource.data.status in ['new', 'quoted', 'booked', 'declined']
        && request.resource.data.statusBy == managerId()
        && request.resource.data.statusAt == request.time
        && (!('quote' in request.resource.data) || request.resource.data.quote.matches('^[2-9A-HJKMNP-Z]{6}$'));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
